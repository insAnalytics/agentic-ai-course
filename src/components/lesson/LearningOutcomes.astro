---
interface Props {
  outcomes: string[];
}

const { outcomes } = Astro.props;
---

<div class="my-6 rounded-lg bg-[var(--color-bg-subtle)] px-5 py-4">
  <p class="mt-0 mb-2 text-xs font-semibold tracking-wide text-[var(--color-green-dark)] uppercase">
    By the end of this lesson, you'll be able to
  </p>
  <ul class="mb-0 ml-5 list-disc text-[var(--color-ink)]">
    {outcomes.map((outcome) => <li>{outcome}</li>)}
  </ul>
</div>
